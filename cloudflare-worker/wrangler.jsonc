{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vokabeltrainer-ai",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "WEB_ORIGIN": ""
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    }
  ]
}
