# ── Vokabeltrainer – Umgebungsvariablen ──────────────────────────────────────
# Kopiere diese Datei nach .env und trage deine Werte ein.

# ── AI-Anbieter ──────────────────────────────────────────────────────────────
# 'openai'  → ChatGPT via OpenAI API (empfohlen, erfordert OPENAI_API_KEY)
# 'ollama'  → lokales Modell (erfordert Ollama)
AI_PROVIDER=openai

# ── OpenAI / ChatGPT ────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Groq (kostenlos, schnell) ───────────────────────────────────────────────
# Key erstellen: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Gemini (kostenloses Kontingent) ─────────────────────────────────
# Key erstellen: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Ollama (lokal, nur bei AI_PROVIDER=ollama) ─────────────────────────────
# Ollama starten:  ollama serve
# Modell ziehen:   ollama pull llama3.1
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
