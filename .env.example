# ── Vokabeltrainer – Umgebungsvariablen ──────────────────────────────────────
# Kopiere diese Datei nach .env und trage deine Werte ein.

# ── AI-Anbieter ──────────────────────────────────────────────────────────────
# 'ollama'  → lokales Modell (empfohlen für Prototyp, kostenlos)
# 'openai'  → Cloud-API (erfordert OPENAI_API_KEY)
AI_PROVIDER=ollama

# ── Ollama (lokal) ───────────────────────────────────────────────────────────
# Ollama starten:  ollama serve
# Modell ziehen:   ollama pull llama3.1
OLLAMA_URL=http://192.168.1.9:11434
OLLAMA_MODEL=llama3.1

# ── OpenAI (Cloud) ───────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
